# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/klinik_db?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/klinik_db?schema=public"

# NextAuth / Security Secret
NEXTAUTH_SECRET="super-secret-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis for Rate Limiting
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# PHI Data Encryption Key (32-byte hexadecimal string)
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Monitoring & Logging
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_APP_URL="https://klinik.example.com"

# Cron Secret for Vercel Cron Jobs
CRON_SECRET="your-vercel-cron-secret-token"
