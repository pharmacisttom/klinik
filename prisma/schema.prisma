datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          String     @default("PATIENT") // ADMIN, DOCTOR, NURSE, PHARMACIST, CASHIER, PATIENT
  phone         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  doctorAppointments  Appointment[]        @relation("DoctorAppointments")
  patientProfile      Patient?
  auditLogs           AuditLog[]
  dataRequests        DataRequest[]
  controlledLogs      ControlledDrugLog[]
  medicalCertificates MedicalCertificate[]
  procedures          ProcedureRecord[]
  emrVersions         EmrVersionHistory[]

  @@index([role])
}

model Patient {
  id               String    @id @default(uuid())
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  hn               String    @unique
  nationalId       String    @unique
  idType           String    @default("THAI_CID") // THAI_CID, PASSPORT, ALIEN_ID
  passportNo       String?
  prefix           String
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String    // MALE, FEMALE, OTHER
  bloodGroup       String?
  allergies        String    @default("[]") // JSON string array
  chronicDiseases  String    @default("[]") // JSON string array
  phone            String
  emergencyContact String?
  address          String
  isNewborn        Boolean   @default(false)
  isDeceased       Boolean   @default(false)
  deceasedDate     DateTime?
  isArchived       Boolean   @default(false)
  archivedReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments        Appointment[]
  prescriptions       Prescription[]
  invoices            Invoice[]
  consents            Consent[]
  controlledLogs      ControlledDrugLog[]
  medicalCertificates MedicalCertificate[]
  taxReceipts         TaxReceipt[]
  procedures          ProcedureRecord[]
  chronicRegistries   ChronicRegistry[]
  adrReports          AdrReport[]

  @@index([nationalId])
  @@index([hn])
  @@index([firstName, lastName])
}

model Appointment {
  id             String      @id @default(uuid())
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  scheduledAt    DateTime
  reason         String
  status         String      @default("SCHEDULED") // SCHEDULED, WAITING, IN_CONSULTATION, COMPLETED, CANCELLED, NO_SHOW
  triageLevel    String      @default("GREEN") // RED, PINK, YELLOW, GREEN, WHITE (MOPH 5-Level Triage)
  vitals         String?     // JSON string
  chiefComplaint String?
  diagnosisCode  String?     // ICD-10-TM
  diagnosisDesc  String?
  dxType         Int         @default(1) // 1=Primary, 2=Comorbidity, 3=Complication, 4=External Cause
  isChronic      Boolean     @default(false)
  doctorNotes    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  prescription Prescription?
  procedures   ProcedureRecord[]
  emrVersions  EmrVersionHistory[]

  @@index([scheduledAt, doctorId])
  @@index([patientId])
  @@index([status])
  @@index([triageLevel])
}

model Medication {
  id               String     @id @default(uuid())
  code             String     @unique
  name             String
  genericName      String
  category         String
  drugClass        String     @default("GENERAL") // e.g. PENICILLIN, NSAID, ANALGESIC
  atcCode          String?    // Anatomical Therapeutic Chemical Code
  tmtCode          String?    // 24-digit Thai Medicines Terminology
  fdaRegNo         String?    // เลขทะเบียนตำรับยา อย.
  storageCondition String     @default("ROOM_TEMP") // ROOM_TEMP, COOL_2_8, FREEZER, LIGHT_PROTECTED
  pregnancyCategory String?   // A, B, C, D, X
  isHighAlert      Boolean    @default(false)
  lasaPair         String?    // Look-Alike Sound-Alike drug pair
  unit             String
  pricePerUnit     Float
  stockQuantity    Int
  reorderLevel     Int        @default(50)
  isControlledDrug Boolean    @default(false)
  controlCategory  String?    // SCHEDULE_2, SCHEDULE_3, SCHEDULE_4 (วัตถุออกฤทธิ์ฯ ข.ด.9 / ข.ด.11)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  prescriptionItems PrescriptionItem[]
  lots              DrugLot[]
  controlledLogs    ControlledDrugLog[]
  adrReports        AdrReport[]
  stockCards        StockCard[]

  @@index([stockQuantity])
  @@index([code])
  @@index([isControlledDrug])
  @@index([isHighAlert])
}

model DrugLot {
  id              String     @id @default(uuid())
  medicationId    String
  medication      Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  lotNumber       String
  expiryDate      DateTime
  initialQuantity Int
  currentQuantity Int
  receivedDate    DateTime   @default(now())

  @@index([medicationId, expiryDate])
}

model ControlledDrugLog {
  id             String       @id @default(uuid())
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id])
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         User         @relation(fields: [doctorId], references: [id])
  quantity       Int
  balanceAfter   Int
  actionType     String       // DISPENSED, RESTOCKED, DISCARDED
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([medicationId, createdAt])
  @@index([actionType])
}

model Prescription {
  id            String       @id @default(uuid())
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  status        String       @default("PENDING") // PENDING, DISPENSED, CANCELLED
  notes         String?
  dispensedAt   DateTime?
  dispensedBy   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items          PrescriptionItem[]
  invoice        Invoice?
  controlledLogs ControlledDrugLog[]

  @@index([status])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id])
  quantity       Int
  dosage         String       // e.g. "1 tab after meal tid"
  unitPrice      Float
  totalPrice     Float

  @@index([prescriptionId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  prescriptionId String?       @unique
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  amount         Float
  discount       Float         @default(0)
  netAmount      Float
  status         String        @default("UNPAID") // UNPAID, PAID, REFUNDED
  paymentMethod  String?       // CASH, QR_PROMPTPAY, CREDIT_CARD
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  taxReceipt TaxReceipt?

  @@index([createdAt])
  @@index([patientId])
  @@index([status])
}

model MedicalCertificate {
  id                  String   @id @default(uuid())
  certificateNumber   String   @unique // e.g. MC-2026-0001
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id])
  doctorId            String
  doctor              User     @relation(fields: [doctorId], references: [id])
  type                String   // WORK_FITNESS, SICK_LEAVE, DRIVER_LICENSE
  fiveDiseasesChecked Boolean  @default(true) // 5 โรคต้องห้ามตาม พ.ร.บ. สถานพยาบาล
  fitForWork          Boolean  @default(true)
  restDays            Int      @default(0)
  startDate           DateTime?
  endDate             DateTime?
  diagnosisText       String
  remarks             String?
  createdAt           DateTime @default(now())

  @@index([patientId])
  @@index([certificateNumber])
}

model TaxReceipt {
  id               String   @id @default(uuid())
  taxReceiptNumber String   @unique // e.g. TAX-2026-00001
  invoiceId        String   @unique
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  patientTaxId     String?
  clinicTaxId      String   @default("0105565000123")
  branchNo         String   @default("00000") // 00000 = สำนักงานใหญ่
  medicalAmount    Float    // ค่ารักษาพยาบาล (ยกเว้น VAT ตาม ม.81(1)(เว))
  taxableAmount    Float    // เวชภัณฑ์/เวชสำอางที่ต้องเสีย VAT
  vatAmount        Float    // 7% VAT
  netTotal         Float
  issuedAt         DateTime @default(now())

  @@index([taxReceiptNumber])
}

model Consent {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose     String   // e.g., "TREATMENT_AND_RECORDS", "MARKETING_NOTIFICATIONS"
  isGranted   Boolean  @default(true)
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  ipAddress   String?

  @@index([patientId])
}

model DataRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // DATA_EXPORT, DATA_ERASURE
  status      String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED_LEGAL_HOLD
  reason      String?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g., "READ_PATIENT_RECORD", "UPDATE_PRESCRIPTION", "EXPORT_PDPA_DATA"
  resource   String   // e.g., "Patient:uuid-1234"
  ipAddress  String?
  details    String?  // JSON string
  tamperHash String?  // HMAC-SHA256 signature for tamper-evident WORM logging
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model EmrVersionHistory {
  id                    String   @id @default(uuid())
  appointmentId         String
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId              String
  doctor                User        @relation(fields: [doctorId], references: [id])
  previousNotes         String?
  previousDiagnosisCode String?
  editedAt              DateTime @default(now())

  @@index([appointmentId])
}

model ProcedureRecord {
  id               String       @id @default(uuid())
  procedureCode    String       // ICD-9-CM code (e.g. 86.59 - Wound suture)
  procedureName    String
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id])
  doctorId         String
  doctor           User         @relation(fields: [doctorId], references: [id])
  appointmentId    String?
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  anesthesiaType   String       @default("LOCAL") // LOCAL, NONE, SEDATION
  consentSigned    Boolean      @default(true)
  vitalSignsBefore String?      // JSON string
  vitalSignsAfter  String?      // JSON string
  notes            String?
  createdAt        DateTime     @default(now())

  @@index([patientId])
  @@index([doctorId])
}

model ChronicRegistry {
  id               String    @id @default(uuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diseaseCode      String    // ICD-10-TM (e.g. E11.9 - Type 2 DM, I10 - Hypertension)
  diseaseName      String
  diagnosedAt      DateTime  @default(now())
  lastHbA1cDate    DateTime?
  lastHbA1cVal     Float?
  lastLipidDate    DateTime?
  lastEgfrVal      Float?
  lastEyeExamDate  DateTime?
  lastFootExamDate DateTime?
  nextDueDate      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([diseaseCode])
}

model AdrReport {
  id            String     @id @default(uuid())
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id])
  reactionDesc  String     // e.g. Stevens-Johnson syndrome, Rash, Anaphylaxis
  severity      String     @default("MODERATE") // MILD, MODERATE, SEVERE, LIFE_THREATENING
  naranjoScore  Int        @default(5) // Naranjo algorithm score
  causality     String     @default("PROBABLE") // DEFINITE, PROBABLE, POSSIBLE, DOUBTFUL
  reportedToFda Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([patientId])
  @@index([medicationId])
}

model ColdChainLog {
  id            String   @id @default(uuid())
  fridgeId      String   @default("FRIDGE-MAIN-01")
  tempCelsius   Float
  isAlarm       Boolean  @default(false)
  inspectorName String
  checkedAt     DateTime @default(now())

  @@index([fridgeId, checkedAt])
}

model StockCard {
  id            String     @id @default(uuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  movementType  String     // RECEIVE_LOT, DISPENSE_PRESCRIPTION, RETURN_SUPPLIER, ADJUSTMENT
  inQty         Int        @default(0)
  outQty        Int        @default(0)
  balanceQty    Int
  referenceDoc  String     // e.g. PO-2026-001 or RX-2026-001
  operatorName  String
  createdAt     DateTime   @default(now())

  @@index([medicationId, createdAt])
}



